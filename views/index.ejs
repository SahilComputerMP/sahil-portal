input,select,textarea{width:100%;padding:13px;margin:8px 0;border:1px solid #ccc;border-radius:8px;font-size:16px}
.submit{background:#159447;color:white;border:0;padding:14px;width:100%;border-radius:8px;font-size:17px}
.contact{display:block;background:#0879dc;color:white;text-align:center;padding:15px;border-radius:9px;text-decoration:none;margin-top:18px}
footer{background:#052d70;color:white;text-align:center;padding:20px}
