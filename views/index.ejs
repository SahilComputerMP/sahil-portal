<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sahil Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container py-5">
  <div class="text-center mb-4">
    <h1 class="text-primary">💻 Sahil Portal</h1>
    <p class="text-muted">Welcome to Sahil Computer</p>
  </div>

  <div class="row g-3">
    <div class="col-6">
      <button class="btn btn-primary w-100">🖨️ Print Portal</button>
    </div>

    <div class="col-6">
      <button class="btn btn-success w-100">📄 PDF Upload</button>
    </div>

    <div class="col-6">
      <button class="btn btn-warning w-100">👤 Retailer Login</button>
    </div>

    <div class="col-6">
      <button class="btn btn-danger w-100">💰 Wallet</button>
    </div>

    <div class="col-12">
      <button class="btn btn-dark w-100">📊 Dashboard</button>
    </div>
  </div>
</div>

</body>
</html>
