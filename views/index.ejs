<script>
function sendWhatsApp(e){
e.preventDefault();
let n=document.getElementById('name').value;
let m=document.getElementById('mobile').value;
let s=document.getElementById('service').value;
let d=document.getElementById('details').value;
let msg="नया ऑनलाइन आवेदन\nनाम: "+n+"\nमोबाइल: "+m+"\nसेवा: "+s+"\nजानकारी: "+d;
window.open("https://wa.me/919691743844?text="+encodeURIComponent(msg),"_blank");
}
</script>
